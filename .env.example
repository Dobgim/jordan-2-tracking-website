# Copy to .env.local and fill in. Vite only exposes variables prefixed VITE_.
# Google Maps JavaScript API key for the live tracking map (used when the key
# in Admin → Settings is empty). Restrict it to your domains in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: point the site at a different Supabase project.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
